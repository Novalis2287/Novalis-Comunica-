# --- Profesor con IA (chat y corrección de preguntas de desarrollo) ---
ANTHROPIC_API_KEY=
# Modelo del profesor (por defecto claude-opus-5-5)
# MODELO_TUTOR=claude-opus-5-5

# --- Audio de los temas (solo hace falta al generar los audios) ---
# Proveedor: elevenlabs (por defecto) o azure
TTS_PROVEEDOR=elevenlabs
ELEVENLABS_API_KEY=
# ID de una voz masculina de España de la biblioteca de ElevenLabs
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Alternativa: Azure Speech (voz es-ES-AlvaroNeural)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOZ=es-ES-AlvaroNeural

# --- Acceso ---
# Si la app está publicada en internet, pon un código para que nadie más
# gaste tu clave de IA. Se pide una vez en el navegador.
# CODIGO_ACCESO=
# PORT=3000
