# La app no usa ningún servicio de IA.

# --- Audio de los temas (solo hace falta al generar los audios) ---
# Proveedor: piper (gratuito, local), elevenlabs o azure
TTS_PROVEEDOR=piper
# Piper: pip install piper-tts, tener ffmpeg y descargar una voz de
# https://huggingface.co/rhasspy/piper-voices (carpeta es/es_ES): el .onnx y su .onnx.json
PIPER_MODELO=
# PIPER_PYTHON=python3
# PIPER_HABLANTE=0
# PIPER_RITMO=1.05

ELEVENLABS_API_KEY=
# ID de una voz masculina de España de la biblioteca de ElevenLabs
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Alternativa: Azure Speech (voz es-ES-AlvaroNeural)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOZ=es-ES-AlvaroNeural

# --- Servidor ---
# PORT=3000

# --- Cuenta y progreso entre dispositivos (Supabase) ---
SUPABASE_URL=
# Clave PUBLICABLE o anon. Nunca introducir una clave secret o service_role aquí.
SUPABASE_PUBLISHABLE_KEY=
